# Gemini API Key - 从 Google AI Studio 获取: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# OpenRouter API Key (Optional fallback for cost reduction & quotas) - https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_ALLOW_PROVIDER_FALLBACKS=false
# Legacy ENABLE_OPENROUTER_STT=false is ignored so old deployments do not accidentally disable voice.
# Set DISABLE_OPENROUTER_STT=true only when you intentionally want to turn off server STT.
DISABLE_OPENROUTER_STT=false
OPENROUTER_STT_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_MAX_MODEL_ATTEMPTS=4
OPENROUTER_VISION_HARD_DEADLINE_SECONDS=26
OPENROUTER_VISION_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-nano-12b-v2-vl:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_TEXT_MODELS=deepseek/deepseek-v4-flash:free,qwen/qwen3-next-80b-a3b-instruct:free,minimax/minimax-m2.5:free
OPENROUTER_NUTRITION_MODELS=deepseek/deepseek-v4-flash:free,qwen/qwen3-next-80b-a3b-instruct:free,minimax/minimax-m2.5:free

# Optional premium provider. Keep free OpenRouter/Gemini as the default route;
# only premium users who enable the switch can use this OpenAI-compatible route.
OPENAI_API_KEY=your-openai-compatible-premium-key
OPENAI_BASE_URL=https://api.cayapi.top/v1
PREMIUM_AI_ENABLED=true
PREMIUM_TEXT_MODELS=gpt-5.4-mini
PREMIUM_NUTRITION_MODELS=gpt-5.4-mini
PREMIUM_VISION_MODELS=gpt-5.4-mini
PREMIUM_AI_TIMEOUT_SECONDS=6
PREMIUM_AI_MAX_MODEL_ATTEMPTS=1
PREMIUM_ADMIN_TOKEN=replace-with-a-long-admin-secret
ACTIVATION_CODE_SECRET=replace-with-a-long-activation-secret

# Required in production. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Supabase production should use the connection pooler, usually port 6543.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-us-central1.pooler.supabase.com:6543/postgres
REQUIRE_SUPABASE_POOLER=true
POSTGRES_POOL_MINCONN=1
POSTGRES_POOL_MAXCONN=8

# Use a shared limiter store in Cloud Run, not memory://.
RATELIMIT_STORAGE_URI=redis://redis:6379/0
CORS_ORIGINS=https://nutrisnap-ai-940406235442.us-central1.run.app

# Run schema updates in a one-shot migration job, not every Cloud Run import.
RUN_DB_MIGRATIONS=false

# Optional comma-separated allowlist for APK downloads.
UPDATE_DOWNLOAD_USERS=admin
